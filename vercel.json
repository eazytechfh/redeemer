{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "vite --config vite.config.ts --port $PORT",
  "buildCommand": "npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/users/:id/reset-password",
      "destination": "/api/users/[id]/reset-password"
    },
    {
      "source": "/api/users/:id/status",
      "destination": "/api/users/[id]/status"
    },
    {
      "source": "/api/crm/clients/:id/stage",
      "destination": "/api/crm/clients/[id]/stage"
    },
    {
      "source": "/api/crm/clients/:id/tags/:tagId",
      "destination": "/api/crm/clients/[id]/tags/[tagId]"
    },
    {
      "source": "/api/crm/clients/:id/tags",
      "destination": "/api/crm/clients/[id]/tags"
    },
    {
      "source": "/api/crm/tags/:id",
      "destination": "/api/crm/tags/[id]"
    },
    {
      "source": "/api/configuration/pipeline-stages/:id",
      "destination": "/api/configuration/pipeline-stages/[id]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
